{
  "expo": {
    "name": "Danger Dash Mobile",
    "slug": "danger-dash-mobile",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.vhite.dangerdashmobile",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#030108"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "assetBundlePatterns": [
      "assets/audio/**/*",
      "assets/images/**/*"
    ],
    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "enablePngCrunchInReleaseBuilds": false
          }
        }
      ]
    ]
  }
}