{
  "expo": {
    "name": "DangerDash Mobile",
    "slug": "dangerdash-mobile",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#030108"
      }
    },
    "assetBundlePatterns": [
      "assets/audio/**/*",
      "assets/images/**/*"
    ],
    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-splash-screen",
      "expo-build-properties"
    ]
  }
}
