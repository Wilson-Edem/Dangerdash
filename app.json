{
  "expo": {
    "name": "DangerDash Mobile",
    "slug": "dangerdash",
    "version": "1.9.6",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/audio/**/*",
      "assets/images/**/*"
    ],
    "android": {
      "package": "com.vhite.dangerdashmobile",
      "userInterfaceStyle": "dark",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030108"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF1744",
          "defaultChannel": "daily-challenges"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#030108"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "style": "light"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enablePngCrunchInReleaseBuilds": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e79e6a1e-aefb-4bb3-964d-cf2599a79a77"
      }
    }
  }
}